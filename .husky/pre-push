#!/usr/bin/env sh
# Git workflow guard — never bypass with SKIP_CHECKS.
has_update=0
while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ "$local_ref" != "-" ] && has_update=1
  case "$remote_ref" in
    refs/heads/main)
      [ "$local_ref" = "-" ] && continue
      echo "❌ ห้าม push เข้า main โดยตรง — เปิด PR จาก codex/* หรือ claude/* แทน"
      exit 1 ;;
  esac
done
[ "$has_update" = "0" ] && exit 0
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
case "$branch" in
  codex/*|claude/*|dependabot/*) ;;
  *) echo "❌ ชื่อ branch ต้องเป็น codex/<งาน> หรือ claude/<งาน>"; exit 1 ;;
esac
