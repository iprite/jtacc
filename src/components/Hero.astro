---
import Icon from "@/components/Icon.astro";
import DashboardPreview from "@/components/DashboardPreview.astro";
import { translations } from "@/constants/translations";

type Lang = "th" | "en";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
---

<section class="relative overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24">
  <div class="dot-grid absolute inset-0 -z-10 opacity-30"></div>
  <div class="line-grid absolute inset-0 -z-10 opacity-20"></div>
  <div class="bg-neon-cyan/10 animate-glow-pulse absolute top-1/4 left-1/2 -z-10 h-[400px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[80px]"></div>
  <div class="bg-neon-blue/10 absolute top-1/3 left-1/4 -z-10 h-[300px] w-[500px] -translate-y-1/2 rounded-full blur-[90px]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      <div class="border-neon-cyan/20 bg-neon-cyan/5 text-neon-cyan animate-pulse-slow inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold">
        <Icon name="sparkles" class="h-3.5 w-3.5" />
        {t.hero.pill}
      </div>

      <h1 class="mt-6 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl">
        {t.hero.title1}{" "}
        <span class="from-neon-blue via-neon-cyan animate-text-shine bg-gradient-to-r to-white bg-[length:200%_auto] bg-clip-text pb-1 text-transparent">
          {t.hero.title2}
        </span>{" "}
        {t.hero.title3}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg md:text-xl">
        {t.hero.subheadline}
      </p>

      <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row">
        <a
          href="#contact"
          class="group from-neon-blue to-neon-cyan relative flex w-full items-center justify-center gap-2 overflow-hidden rounded-full bg-gradient-to-r px-8 py-3.5 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:scale-102 hover:shadow-[0_0_30px_rgba(0,240,255,0.4)] sm:w-auto"
        >
          {t.common.consultNow}
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
        <a
          href="tel:0986646442"
          class="group flex w-full items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 px-8 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:border-white/20 hover:bg-white/10 sm:w-auto"
        >
          <Icon name="phone" class="text-neon-cyan h-3.5 w-3.5 animate-pulse" />098-664-6442
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-500">
        <div class="flex items-center gap-1.5"><Icon name="check" class="text-neon-cyan h-3.5 w-3.5" />{t.hero.trust1}</div>
        <div class="flex items-center gap-1.5"><Icon name="check" class="text-neon-cyan h-3.5 w-3.5" />{t.hero.trust2}</div>
        <div class="flex items-center gap-1.5"><Icon name="check" class="text-neon-cyan h-3.5 w-3.5" />{t.hero.trust3}</div>
      </div>

      <div class="w-full">
        <DashboardPreview lang={lang} />
      </div>
    </div>
  </div>
</section>
