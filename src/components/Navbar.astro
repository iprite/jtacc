---
import Icon from "@/components/Icon.astro";
import { translations } from "@/constants/translations";

type Lang = "th" | "en";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];

const navLinks = [
  { href: "#features", label: t.navbar.features },
  { href: "#integrations", label: t.navbar.integrations },
  { href: "#about", label: t.navbar.about },
  { href: "#contact", label: t.navbar.contact },
];
const langBtn = (active: boolean) =>
  active
    ? "bg-gradient-to-r from-neon-blue to-neon-cyan text-white font-bold"
    : "text-slate-400 hover:text-white";
---

<header
  data-navbar
  class="sticky top-0 z-50 w-full border-b border-transparent bg-transparent transition-all duration-300"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      {/* Logo */}
      <div class="flex items-center gap-2">
        <div
          class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-neon-blue to-neon-cyan p-[1px]"
        >
          <div
            class="bg-obsidian text-neon-cyan flex h-full w-full items-center justify-center rounded-[7px]"
          >
            <Icon name="activity" class="h-4.5 w-4.5 animate-pulse" />
          </div>
          <div
            class="absolute -inset-0.5 -z-10 rounded-lg bg-gradient-to-tr from-neon-blue to-neon-cyan opacity-40 blur-[4px]"
          >
          </div>
        </div>
        <a href={`/${lang}`} class="flex items-center text-xl font-bold tracking-tight text-white">
          jtacc<span class="text-neon-cyan ml-[1px] animate-pulse font-extrabold">.</span>
        </a>
      </div>

      {/* Desktop nav */}
      <nav class="hidden items-center gap-8 md:flex">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="hover:text-neon-cyan text-sm font-medium text-slate-300 transition-colors"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      {/* CTA & language */}
      <div class="hidden items-center gap-4 md:flex">
        <div
          class="mr-2 flex items-center rounded-lg border border-white/10 bg-[#0f1424]/60 p-0.5 font-mono text-xs shadow-inner"
        >
          <a href="/th" class={`rounded px-2 py-1 transition-all duration-200 ${langBtn(lang === "th")}`}>TH</a>
          <a href="/en" class={`rounded px-2 py-1 transition-all duration-200 ${langBtn(lang === "en")}`}>EN</a>
        </div>

        <a href="mailto:admin@jtacc.co.th" class="mr-2 text-sm font-medium text-slate-300 transition-colors hover:text-white">
          admin@jtacc.co.th
        </a>
        <a href="tel:0986646442" class="mr-2 flex items-center gap-1.5 text-sm font-medium text-slate-300 transition-colors hover:text-white">
          <Icon name="phone" class="text-neon-cyan h-4 w-4 animate-pulse" />098-664-6442
        </a>
        <a
          href="#contact"
          class="group hover:border-neon-cyan/40 hover:bg-neon-cyan/10 relative inline-flex items-center justify-center gap-1.5 overflow-hidden rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white shadow-lg transition-all duration-300 hover:shadow-[0_0_20px_rgba(0,240,255,0.25)]"
        >
          {t.common.consultNow}
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>

      {/* Mobile buttons */}
      <div class="flex items-center gap-2 md:hidden">
        <div class="flex rounded-lg border border-white/10 bg-[#0f1424]/60 p-0.5 font-mono text-xs">
          <a href={lang === "th" ? "/en" : "/th"} class="text-neon-cyan px-2.5 py-0.5 font-bold">
            {lang.toUpperCase()}
          </a>
        </div>
        <button
          type="button"
          data-navbar-toggle
          class="inline-flex items-center justify-center rounded-md p-2 text-slate-400 hover:bg-white/5 hover:text-white focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <Icon name="menu" class="block h-6 w-6" data-navbar-icon-menu />
          <Icon name="x" class="hidden h-6 w-6" data-navbar-icon-close />
        </button>
      </div>
    </div>
  </div>

  {/* Mobile menu */}
  <div
    id="mobile-menu"
    data-navbar-menu
    class="invisible max-h-0 overflow-hidden border-b border-white/5 bg-obsidian/95 opacity-0 backdrop-blur-lg transition-all duration-300 ease-in-out md:hidden"
  >
    <div class="space-y-1 px-4 py-3 sm:px-6">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            data-navbar-close
            class="hover:text-neon-cyan block rounded-md px-3 py-2 text-base font-medium text-slate-300 hover:bg-white/5"
          >
            {l.label}
          </a>
        ))
      }
      <div class="flex flex-col gap-2 border-t border-white/5 pt-4 pb-2">
        <div class="flex items-center justify-between px-3 py-2">
          <span class="text-sm font-medium text-slate-400">Language / ภาษา</span>
          <div class="flex rounded-lg border border-white/10 bg-[#0f1424]/60 p-0.5 font-mono text-xs">
            <a href="/th" class={`rounded px-3 py-1 transition-colors ${lang === "th" ? "bg-neon-cyan/20 text-neon-cyan font-bold" : "text-slate-400"}`}>ไทย</a>
            <a href="/en" class={`rounded px-3 py-1 transition-colors ${lang === "en" ? "bg-neon-cyan/20 text-neon-cyan font-bold" : "text-slate-400"}`}>EN</a>
          </div>
        </div>
        <a href="mailto:admin@jtacc.co.th" data-navbar-close class="block rounded-md px-3 py-2 text-center text-base font-medium text-slate-300 hover:bg-white/5">
          admin@jtacc.co.th
        </a>
        <a href="tel:0986646442" data-navbar-close class="flex items-center justify-center gap-1.5 rounded-md px-3 py-2 text-center text-base font-medium text-slate-300 hover:bg-white/5">
          <Icon name="phone" class="text-neon-cyan h-4 w-4" />098-664-6442
        </a>
        <a href="#contact" data-navbar-close class="border-neon-cyan/30 bg-neon-cyan/10 hover:bg-neon-cyan/20 flex items-center justify-center gap-1.5 rounded-full border py-2.5 text-center text-base font-medium text-white">
          {t.common.consultNow}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-navbar]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-navbar-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-navbar-menu]");
  const iconMenu = document.querySelector<HTMLElement>("[data-navbar-icon-menu]");
  const iconClose = document.querySelector<HTMLElement>("[data-navbar-icon-close]");

  const SCROLLED =
    "border-white/8 bg-obsidian/75 backdrop-blur-md shadow-[0_4px_30px_rgba(0,0,0,0.4)]".split(" ");
  if (header) {
    const onScroll = () => {
      const on = window.scrollY > 20;
      header.classList.toggle("border-transparent", !on);
      header.classList.toggle("bg-transparent", !on);
      SCROLLED.forEach((c) => header.classList.toggle(c, on));
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  let open = false;
  function setOpen(v: boolean) {
    open = v;
    if (!menu) return;
    menu.classList.toggle("max-h-screen", v);
    menu.classList.toggle("opacity-100", v);
    menu.classList.toggle("visible", v);
    menu.classList.toggle("max-h-0", !v);
    menu.classList.toggle("opacity-0", !v);
    menu.classList.toggle("invisible", !v);
    iconMenu?.classList.toggle("hidden", v);
    iconClose?.classList.toggle("hidden", !v);
    toggle?.setAttribute("aria-expanded", String(v));
  }
  toggle?.addEventListener("click", () => setOpen(!open));
  document
    .querySelectorAll("[data-navbar-close]")
    .forEach((el) => el.addEventListener("click", () => setOpen(false)));
</script>
