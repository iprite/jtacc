---
import Icon from "@/components/Icon.astro";
import { translations } from "@/constants/translations";

type Lang = "th" | "en";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
const requiredLabel = lang === "th" ? "จำเป็นต้องระบุข้อมูล" : "Required fields";
const sentTitle = lang === "th" ? "ส่งข้อมูลสำเร็จ!" : "Message Sent!";
---

<section id="contact" class="relative overflow-hidden border-t border-white/5 bg-[#090d16]/30 py-20 md:py-28">
  <div class="bg-neon-cyan/5 absolute top-1/2 left-1/2 -z-10 h-[400px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[120px]"></div>
  <div class="bg-neon-purple/5 absolute bottom-0 right-1/4 -z-10 h-[300px] w-[300px] rounded-full blur-[100px]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="text-neon-cyan animate-pulse-slow flex items-center justify-center gap-1.5 text-xs font-bold uppercase tracking-widest">
        <Icon name="sparkles" class="h-4 w-4" /> {t.contactSection.pill}
      </h2>
      <p class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">{t.contactSection.title}</p>
      <p class="mt-4 text-sm leading-relaxed text-slate-400 sm:text-base">{t.contactSection.desc}</p>
    </div>

    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
      {/* Info cards */}
      <div class="flex flex-col gap-6 lg:col-span-5">
        <a href="tel:0986646442" class="group hover:border-neon-cyan/40 hover:bg-obsidian-light/60 bg-obsidian-light/40 relative block rounded-2xl border border-white/5 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-[0_0_30px_rgba(0,240,255,0.05)]">
          <div class="from-neon-blue to-neon-cyan absolute -inset-px -z-10 rounded-[15px] bg-gradient-to-r opacity-0 blur-[2px] transition-opacity duration-300 group-hover:opacity-25"></div>
          <div class="flex items-center gap-4">
            <div class="bg-neon-cyan/10 text-neon-cyan border-neon-cyan/20 flex h-12 w-12 items-center justify-center rounded-xl border transition-transform duration-300 group-hover:scale-105">
              <Icon name="phone" class="h-5 w-5" />
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-widest text-slate-400">{t.contactSection.cardPhoneTitle}</span>
              <span class="group-hover:text-neon-cyan mt-1 block text-lg font-bold text-white transition-colors">098-664-6442</span>
            </div>
          </div>
        </a>

        <a href="mailto:admin@jtacc.co.th" class="group hover:border-neon-blue/40 hover:bg-obsidian-light/60 bg-obsidian-light/40 relative block rounded-2xl border border-white/5 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-[0_0_30px_rgba(59,130,246,0.05)]">
          <div class="from-neon-indigo to-neon-blue absolute -inset-px -z-10 rounded-[15px] bg-gradient-to-r opacity-0 blur-[2px] transition-opacity duration-300 group-hover:opacity-25"></div>
          <div class="flex items-center gap-4">
            <div class="bg-neon-blue/10 text-neon-blue border-neon-blue/20 flex h-12 w-12 items-center justify-center rounded-xl border transition-transform duration-300 group-hover:scale-105">
              <Icon name="mail" class="h-5 w-5" />
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-widest text-slate-400">{t.contactSection.cardEmailTitle}</span>
              <span class="group-hover:text-neon-blue mt-1 block text-base font-bold text-white transition-colors">admin@jtacc.co.th</span>
            </div>
          </div>
        </a>

        <div class="bg-obsidian-light/40 relative rounded-2xl border border-white/5 p-6 backdrop-blur-md">
          <div class="flex items-center gap-4">
            <div class="bg-neon-purple/10 text-neon-purple border-neon-purple/20 flex h-12 w-12 items-center justify-center rounded-xl border">
              <Icon name="map-pin" class="h-5 w-5" />
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-widest text-slate-400">{t.contactSection.cardLocationTitle}</span>
              <span class="mt-1 block text-sm font-semibold leading-relaxed text-slate-200">{t.contactSection.cardLocationDesc}</span>
            </div>
          </div>
        </div>
      </div>

      {/* Form */}
      <div class="relative lg:col-span-7">
        <div class="bg-obsidian-light/50 flex h-full flex-col justify-between rounded-2xl border border-white/10 p-6 backdrop-blur-lg sm:p-8">
          <form data-contact-form class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-xs font-semibold text-slate-300">{t.contactSection.formName} *</label>
                <input type="text" id="name" name="name" required class="focus:border-neon-cyan focus:ring-neon-cyan w-full rounded-lg border border-white/10 bg-[#080b13] px-3 py-2.5 text-sm text-white placeholder-slate-600 transition-colors focus:outline-none focus:ring-1" />
              </div>
              <div>
                <label for="phone" class="mb-1.5 block text-xs font-semibold text-slate-300">{t.contactSection.formPhone} *</label>
                <input type="tel" id="phone" name="phone" required class="focus:border-neon-cyan focus:ring-neon-cyan w-full rounded-lg border border-white/10 bg-[#080b13] px-3 py-2.5 text-sm text-white placeholder-slate-600 transition-colors focus:outline-none focus:ring-1" />
              </div>
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-xs font-semibold text-slate-300">{t.contactSection.formEmail} *</label>
              <input type="email" id="email" name="email" required class="focus:border-neon-cyan focus:ring-neon-cyan w-full rounded-lg border border-white/10 bg-[#080b13] px-3 py-2.5 text-sm text-white placeholder-slate-600 transition-colors focus:outline-none focus:ring-1" />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-xs font-semibold text-slate-300">{t.contactSection.formMessage}</label>
              <textarea id="message" name="message" rows="4" class="focus:border-neon-cyan focus:ring-neon-cyan w-full resize-none rounded-lg border border-white/10 bg-[#080b13] px-3 py-2.5 text-sm text-white placeholder-slate-600 transition-colors focus:outline-none focus:ring-1"></textarea>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
              <p class="text-[10px] text-slate-500">* {requiredLabel}</p>
              <button type="submit" data-contact-submit class="group from-neon-blue to-neon-cyan relative flex cursor-pointer items-center justify-center gap-1.5 overflow-hidden rounded-xl bg-gradient-to-r px-6 py-3 text-xs font-bold text-white shadow-lg transition-all duration-300 hover:scale-102 hover:shadow-[0_0_20px_rgba(0,240,255,0.3)] disabled:opacity-50 disabled:hover:scale-100">
                <span data-contact-spinner class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/20 border-t-white"></span>
                <span data-contact-label class="flex items-center gap-1.5">
                  {t.contactSection.formSubmit}
                  <Icon name="send" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </span>
              </button>
            </div>
          </form>

          {/* Success banner */}
          <div data-contact-success class="animate-fade-in absolute inset-4 hidden flex-col items-center justify-center rounded-xl border border-emerald-500/20 bg-[#0c101c] p-6 text-center backdrop-blur-md">
            <Icon name="check-circle-2" class="mb-3 h-10 w-10 animate-bounce text-emerald-400" />
            <h4 class="mb-2 text-sm font-bold text-white">{sentTitle}</h4>
            <p class="max-w-xs text-xs text-slate-400">{t.contactSection.formSuccess}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const submit = document.querySelector<HTMLButtonElement>("[data-contact-submit]");
  const spinner = document.querySelector<HTMLElement>("[data-contact-spinner]");
  const label = document.querySelector<HTMLElement>("[data-contact-label]");
  const success = document.querySelector<HTMLElement>("[data-contact-success]");

  if (form && submit && spinner && label && success) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      submit.disabled = true;
      spinner.classList.remove("hidden");
      label.classList.add("hidden");

      // Simulated request (mirrors the former React island behavior).
      window.setTimeout(() => {
        spinner.classList.add("hidden");
        label.classList.remove("hidden");
        submit.disabled = false;
        form.reset();
        success.classList.remove("hidden");
        success.classList.add("flex");
        window.setTimeout(() => {
          success.classList.add("hidden");
          success.classList.remove("flex");
        }, 5000);
      }, 1200);
    });
  }
</script>
