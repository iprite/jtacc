---
import Icon from "@/components/Icon.astro";
import { translations } from "@/constants/translations";

type Lang = "th" | "en";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/5 bg-[#070b13] pt-16 pb-8">
  <div class="bg-neon-cyan/5 absolute bottom-0 left-1/2 -z-10 h-[200px] w-[500px] -translate-x-1/2 translate-y-1/2 rounded-full blur-[80px]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 pb-12 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2 flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <div class="from-neon-blue to-neon-cyan relative flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr p-[1px]">
            <div class="bg-obsidian text-neon-cyan flex h-full w-full items-center justify-center rounded-[7px]">
              <Icon name="activity" class="h-3.5 w-3.5" />
            </div>
          </div>
          <span class="text-lg font-bold tracking-tight text-white">jtacc</span>
        </div>
        <p class="max-w-sm text-xs leading-relaxed text-slate-400">{t.footer.desc}</p>

        <div class="mt-2 flex flex-col gap-2.5 text-xs text-slate-300">
          <a href="tel:0986646442" class="hover:text-neon-cyan flex items-center gap-2 transition-colors">
            <Icon name="phone" class="text-neon-cyan h-3.5 w-3.5" />098-664-6442
          </a>
          <a href="mailto:admin@jtacc.co.th" class="hover:text-neon-blue flex items-center gap-2 transition-colors">
            <Icon name="mail" class="text-neon-blue h-3.5 w-3.5" />admin@jtacc.co.th
          </a>
        </div>

        <div class="mt-2 flex gap-4">
          <a href="#" class="text-slate-400 transition-colors hover:text-white" aria-label="Twitter">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="text-slate-400 transition-colors hover:text-white" aria-label="GitHub">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          </a>
          <a href="#" class="text-slate-400 transition-colors hover:text-white" aria-label="LinkedIn">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-300">{t.footer.columns.product}</span>
        <a href="#features" class="text-xs text-slate-400 transition-colors hover:text-white">{t.navbar.features}</a>
        <a href="#integrations" class="text-xs text-slate-400 transition-colors hover:text-white">{t.navbar.integrations}</a>
        <a href="#about" class="text-xs text-slate-400 transition-colors hover:text-white">{t.navbar.about}</a>
        <a href="#contact" class="text-xs text-slate-400 transition-colors hover:text-white">{t.navbar.contact}</a>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-300">{t.footer.columns.company}</span>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">About Us</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">CPA Partners</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">Security &amp; Trust</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">Contact</a>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-300">{t.footer.columns.legal}</span>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">Privacy Policy</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">Terms of Service</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">CPA Audit Guard</a>
        <a href="#" class="text-xs text-slate-400 transition-colors hover:text-white">RD Regulations</a>
      </div>
    </div>

    <div class="border-t border-white/5 pt-8 pb-4">
      <p class="text-center text-[10px] leading-relaxed text-slate-500 sm:text-left">{t.footer.disclaimer}</p>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-[11px] text-slate-500 sm:flex-row">
      <span>&copy; {year} jtacc Inc. {t.footer.rightsReserved}.</span>
      <div class="flex gap-4">
        <a href="#" class="transition-colors hover:text-white">{t.footer.cookieSettings}</a>
        <span>&middot;</span>
        <a href="#" class="transition-colors hover:text-white">{t.footer.securityAudits}</a>
      </div>
    </div>
  </div>
</footer>
